{
  "version": "1.0",
  "runtime": "A1OS",
  "services": [
    {
      "name": "a1os-platform-api",
      "type": "control-plane",
      "database": ".private/platform/a1os-platform-api/api/a1os_state.db",
      "health_local": "http://127.0.0.1:3013/v1/health",
      "adapter": [
        "ops/adapters/restart-platform-api.sh"
      ],
      "boot_order": 10
    },
    {
      "name": "cloudflare-edge-observer",
      "type": "observer",
      "database": null,
      "health_local": "external",
      "adapter": [],
      "boot_order": 999
    }
  ],
  "external_observer": null
}
