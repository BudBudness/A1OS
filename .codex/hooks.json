{
  "description": "A1OS instruction-integrity enforcement for local Codex sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.github/hooks/a1os_instruction_guard.py\" --runtime codex",
            "timeout": 30,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading A1OS instruction chain"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.github/hooks/a1os_instruction_guard.py\" --runtime codex",
            "timeout": 30,
            "statusMessage": "Checking A1OS instruction integrity"
          }
        ]
      }
    ]
  }
}
