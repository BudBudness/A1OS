{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1OS Capability",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "a1os/v1"},
    "kind": {"const": "Capability"},
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["category", "operations", "dependencies", "verification"],
      "properties": {
        "category": {"type": "string"},
        "description": {"type": "string"},
        "operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "providers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verification": {"type": "object", "required": ["required"], "properties": {"required": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "recovery": {"type": "object", "properties": {"supported": {"type": "boolean"}}, "additionalProperties": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
