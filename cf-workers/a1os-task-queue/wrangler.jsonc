{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a1os-d1-task-queue",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a1os-task-queue",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
