{
  "name": "little-oaks-enquiries-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "little-oaks-enquiries-staging",
    "database_id": "898c217a-45b5-4c86-b204-f23be9645d23"
  }]
}
