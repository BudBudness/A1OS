{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/a1os_instruction_guard.py",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/a1os_instruction_guard.py",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
